# ---- Storage ----
# Where projects, uploads, downloaded images and renders live (default: ./data)
K_VERSATION_DATA_DIR=./data
# local | s3   (s3 is a documented extension point; only local is implemented in V1)
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=

# ---- OpenAI (transcription, moment analysis, title, vision ranking) ----
# Leave empty to run fully offline in MOCK mode (heuristics + placeholder images).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini

# ---- Providers ----
# openai | whisperx | mock   (defaults to openai when OPENAI_API_KEY is set, else mock)
# TRANSCRIPTION_PROVIDER=openai
# For whisperx: URL of a self-hosted WhisperX HTTP service returning word_segments
# WHISPERX_URL=http://localhost:9000/transcribe
# openai | mock
# LLM_PROVIDER=openai

# Vision re-ranking of image candidates (toggle). Defaults to on when OPENAI_API_KEY is set.
VISION_RANKING_ENABLED=true
VISION_MAX_CANDIDATES=8
# Below this confidence the moment is skipped rather than given a weak image
VISION_MIN_CONFIDENCE=0.55

# ---- Image search ----
# Comma-separated, tried in order. wikimedia needs no key. Others need keys below.
# Options: wikimedia, serpapi, bing, google, mock
IMAGE_SEARCH_PROVIDERS=wikimedia
# SERPAPI_API_KEY=
# BING_IMAGE_SEARCH_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
SEARCH_MIN_CANDIDATES=8
SEARCH_MAX_CANDIDATES=20
SEARCH_RETRIES=3
SEARCH_TIMEOUT_MS=15000
IMAGE_MIN_WIDTH=800
IMAGE_MIN_HEIGHT=500

# ---- Rendering ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
RENDER_KEN_BURNS=false
RENDER_BURN_SUBTITLES=false
RENDER_FADE_SECONDS=0.5

# debug | info | warn | error
LOG_LEVEL=info

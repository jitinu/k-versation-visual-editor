# ---- Storage ----
# Where projects, uploads, downloaded images and renders live (default: ./data)
K_VERSATION_DATA_DIR=./data
# local | s3   (s3 is a documented extension point; only local is implemented in V1)
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=

# ---- Free local AI (defaults; nothing to set) ----
# Transcription: faster-whisper (pip install faster-whisper). tiny|base|small|medium|large-v3
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu            # cuda for NVIDIA GPUs
LOCAL_WHISPER_COMPUTE_TYPE=int8     # float16 on GPU
PYTHON_PATH=python3
# LLM + vision: Ollama (ollama serve; ollama pull llama3.1; ollama pull llava)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava
# OLLAMA_API_KEY=ollama             # only if your Ollama is behind an auth proxy

# ---- OpenAI (optional paid alternative for transcription, analysis, title, vision) ----
# Setting a key switches the defaults to TRANSCRIPTION_PROVIDER=openai, LLM_PROVIDER=openai.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini

# ---- Providers ----
# local | openai | whisperx | mock   (default: local, or openai when OPENAI_API_KEY is set)
# TRANSCRIPTION_PROVIDER=local
# For whisperx: URL of a self-hosted WhisperX HTTP service returning word_segments
# WHISPERX_URL=http://localhost:9000/transcribe
# ollama | openai | mock   (default: ollama, or openai when OPENAI_API_KEY is set)
# LLM_PROVIDER=ollama

# Vision re-ranking of image candidates (toggle). On unless LLM_PROVIDER=mock.
VISION_RANKING_ENABLED=true
VISION_MAX_CANDIDATES=8
# Below this confidence the moment is skipped rather than given a weak image
VISION_MIN_CONFIDENCE=0.55

# ---- Image search ----
# Comma-separated; all are queried in parallel and pooled (authoritative results sorted first).
# wikimedia / openverse / duckduckgo need no key. google (free 100/day), serpapi, bing need keys below.
IMAGE_SEARCH_PROVIDERS=wikimedia,openverse,duckduckgo
# SERPAPI_API_KEY=
# BING_IMAGE_SEARCH_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
SEARCH_MIN_CANDIDATES=8
SEARCH_MAX_CANDIDATES=20
SEARCH_RETRIES=3
SEARCH_TIMEOUT_MS=15000
IMAGE_MIN_WIDTH=800
IMAGE_MIN_HEIGHT=500

# ---- Rendering ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
RENDER_KEN_BURNS=false
RENDER_BURN_SUBTITLES=false
RENDER_FADE_SECONDS=0.5

# debug | info | warn | error
LOG_LEVEL=info

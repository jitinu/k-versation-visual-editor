# Optional: enables real audio transcription and LLM visual-moment analysis.
OPENAI_API_KEY=

# Optional provider overrides.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini

# Local storage and media tools.
VISUAL_STORY_MAKER_DATA_DIR=./data
MAX_UPLOAD_MB=1024
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
